# Arquivo: .editorconfig | Função: padronizar a edição dos arquivos do projeto.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.js]
indent_size = 2

[*.css]
indent_size = 4

[{*.html,*.json,*.md}]
indent_size = 2

[LICENSE]
insert_final_newline = true